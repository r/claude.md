# Copy to ~/.config/vault-spooler.env and chmod 600. NEVER commit the real file —
# ~/.claude/.gitignore already ignores *.env, and this .example is the only
# version that belongs in git.
#
# Same split as otel-spooler: the code carries no hostnames or credentials, so
# bin/vault-spooler.py ships unmodified to the public repo and everything
# site-specific lives here.

# WebDAV endpoint scoped to the vault's Inbox/Unprocessed/ — and nothing else.
# The endpoint is deliberately narrow: even a fully compromised laptop key can
# only drop files into a staging folder that a human or the vault agent reviews, never touch a
# canonical vault note.
VAULT_UPSTREAM=https://vault-inbox.example.com

# rclone htpasswd credentials for that endpoint. Use a credential dedicated to
# this queue, not the one Obsidian uses for reading — different blast radius.
VAULT_USER=changeme
VAULT_PASS=changeme

# CA bundle, if the endpoint is behind a private CA.
VAULT_CA=/home/youruser/.claude/tls/ca-chain.pem

# LOCAL DELIVERY — only on a host where the vault is a local directory.
# When set, notes are written straight into Inbox/Unprocessed and HTTP is skipped
# entirely; this takes precedence over VAULT_UPSTREAM. Leave it unset on a laptop,
# where queue-and-forward is the entire point.
#
# The tradeoff, stated plainly: over HTTP, the reverse proxy owns three rules — the
# filename regex, PUT-only, and the body cap. Writing to the directory bypasses all
# three, so vault-spooler re-enforces them itself (see local_put). That duplication
# is the cost, and it drifts silently if the vhost changes without this changing too.
#
# If the vault is owned by another uid (an agent's own service account, say), the
# drop directory needs to be group-writable via a DEDICATED group. Do not add
# yourself to the vault owner's primary group — that grants write far beyond this
# one directory:
#   sudo groupadd -f vault-drop
#   sudo usermod -aG vault-drop "$USER"                # needs a fresh login
#   sudo chgrp vault-drop <vault>/Inbox/Unprocessed
#   sudo chmod 2775       <vault>/Inbox/Unprocessed    # setgid; owner unchanged
# Rollback: sudo chgrp <original-group> <dir> && sudo chmod 0755 <dir>
#
# Safe to set before the permissions land: an unwritable inbox behaves exactly
# like being offline — every note is retained and retried, nothing quarantined.
#VAULT_LOCAL_INBOX=/home/youruser/vault/Inbox/Unprocessed

# Optional tuning (defaults shown).
#VAULT_QUEUE_DIR=/home/youruser/.claude/vault-queue
#VAULT_FLUSH_INTERVAL=10
#VAULT_MAX_INTERVAL=300
#VAULT_TIMEOUT=15
#VAULT_SENT_RETAIN_DAYS=7
