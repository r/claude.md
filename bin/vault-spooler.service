# systemd USER service for the vault spooler — drains ~/.claude/vault-queue to
# the vault's inbox whenever it is reachable.
#
# Note this is a DRAINER, not a capture path: bin/vault-write puts notes on disk
# by itself, so nothing is lost while this service is stopped, failed, or not yet
# installed. It only moves already-durable files, and delivery is idempotent on the
# note's content hash, so a restart can never double-write.
#
# Install:
#   mkdir -p ~/.local/bin ~/.config/systemd/user
#   cp vault-spooler.py ~/.local/bin/
#   cp vault-spooler.env.example ~/.config/vault-spooler.env   # then edit it (chmod 600)
#   cp vault-spooler.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now vault-spooler
#   loginctl enable-linger "$USER"   # so it drains when you're not logged in
#
# IF ~/.config IS ON A SHARED NETWORK HOME (nuc-1 / nuc-3 mount nas-1's export):
#   `systemctl --user enable` does not enable this on the machine you ran it on.
#   The unit file AND the default.target.wants symlink that represents enablement
#   both live on the shared home, so it is enabled on EVERY host that mounts it and
#   starts a user systemd instance for you. Two drainers on one queue is not a
#   double-write — delivery is idempotent on the note's content hash, as above —
#   but it is two processes racing to move and unlink the same files.
#
#   You cannot fix it with `systemctl --user disable` on the other host: that
#   unlinks the shared symlink and stops the spooler everywhere. Pin it instead,
#   with a DROP-IN rather than an edit here, because the `cp` above would discard
#   an inline edit on the next reinstall:
#
#     mkdir -p ~/.config/systemd/user/vault-spooler.service.d
#     printf '[Unit]\nConditionHost=%s\n' "$(hostname -s)" \
#       > ~/.config/systemd/user/vault-spooler.service.d/10-pin-to-host.conf
#     systemctl --user daemon-reload
#
#   Deliberately NOT a ConditionHost in this file: this repo is portable across
#   machines and a hardcoded hostname here would stop the spooler working on all
#   the others. The hazard belongs to that one shared home, so the fix lives there.
#   Applied on nuc-3 2026-08-05. Background: nuc-3's code-sync docs/MULTI-HOST.md.
#
# Health:  python3 ~/.local/bin/vault-spooler.py --status
[Unit]
Description=Vault knowledge spooler (queue notes offline, deliver on reconnect)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/vault-spooler.env
ExecStart=/usr/bin/env python3 %h/.local/bin/vault-spooler.py
# on-failure, NOT always (otel-spooler.service uses always, deliberately different):
# this drainer exits 0 when VAULT_UPSTREAM is unset, and Restart=always would turn
# that clean exit into a restart loop every 5 seconds forever. on-failure leaves an
# unconfigured spooler stopped and still restarts a genuine crash.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
